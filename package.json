{
  "name": "adriansantos-blog",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Blog pessoal de Adrian Santos — Vite + React + TS, Cloudflare Pages Functions + D1.",
  "scripts": {
    "dev": "vite",
    "dev:cf": "wrangler pages dev -- npm run dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler pages dev",
    "cf:deploy": "npm run build && wrangler pages deploy",
    "db:schema:local": "wrangler d1 execute adriansantos-blog-prod --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute adriansantos-blog-prod --local --file=./seed.local.sql",
    "db:schema:remote": "wrangler d1 execute adriansantos-blog-prod --remote --file=./schema.sql",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tiptap/extension-image": "^2.10.3",
    "@tiptap/extension-link": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wrangler": "^3.80.0"
  }
}
